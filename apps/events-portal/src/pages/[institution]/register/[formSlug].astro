---
import PortalLayout from '../../../layouts/PortalLayout.astro';
import { portalApi } from '../../../lib/api';

const { institution, formSlug } = Astro.params;
if (!institution || !formSlug) return new Response('Formulario no encontrado', { status: 404 });

let listing: Awaited<ReturnType<typeof portalApi.events>>;
let form: any;
const choicesFor = (field: any): string[] => Array.isArray(field.options?.choices)
  ? field.options.choices
  : Array.isArray(field.options)
    ? field.options
    : [];
try {
  [listing, form] = await Promise.all([
    portalApi.events(institution),
    fetch(`${portalApi.serverApiUrl}/public/registration-forms/${encodeURIComponent(formSlug)}`).then((response) =>
      response.ok ? response.json() : Promise.reject()
    ),
  ]);
} catch {
  return new Response('Formulario no disponible', { status: 404 });
}
---

<PortalLayout organization={listing.organization} title={`Registro · ${form.title} · ${listing.organization.name}`}>
  <section class="reg-page-wrap">
    <div class="reg-container">
      <a href={`/${institution}`} class="reg-back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        <span>Volver al portal</span>
      </a>

      <div class="reg-form-card">
        <div class="reg-card-header">
          <span class="reg-badge">REGISTRO OFICIAL</span>
          <h1 class="reg-title">{form.title}</h1>
          {form.description && <p class="reg-desc">{form.description}</p>}
        </div>

        <form id="registration-form" data-api={portalApi.apiUrl} data-slug={form.slug} class="reg-form">
          <div class="form-fields-grid">
            {form.fields.map((field: any) => (
              <div class:list={["form-field-group", `field-${field.type}`]}>
                {field.type === 'header' ? (
                  <h2 class="embedded-heading">{field.options?.text || field.label}</h2>
                ) : field.type === 'paragraph' ? (
                  <p class="embedded-paragraph">{field.options?.text || field.label}</p>
                ) : field.type === 'image' ? (
                  field.options?.imageUrl && <img class="embedded-image" src={field.options.imageUrl} alt={field.options?.imageAlt || field.label} />
                ) : field.type === 'divider' ? (
                  <hr class="embedded-divider" />
                ) : <>
                {(field.options?.showLabel !== false) && <label for={field.key} class="field-label">
                  <span>{field.label}</span>
                  {field.required && <span class="req-star">*</span>}
                </label>}

                {field.type === 'textarea' ? (
                  <textarea
                    id={field.key}
                    name={field.key}
                    required={field.required}
                    placeholder="Escribe tu respuesta aquí..."
                    class="form-input textarea"
                  />
                ) : field.type === 'select' ? (
                  <select id={field.key} name={field.key} required={field.required} class="form-input select">
                    <option value="">Selecciona una opción</option>
                    {Array.isArray(field.options) &&
                      field.options.map((option: string | { label: string; value: string }) => (
                        <option value={typeof option === 'string' ? option : option.value}>{typeof option === 'string' ? option : option.label}</option>
                      ))}
                  </select>
                ) : field.type === 'radio' ? (
                  <div class="choice-group">
                    {choicesFor(field).map((option: string) => (
                      <label class="choice-option"><input type="radio" name={field.key} value={option} required={field.required} /><span>{option}</span></label>
                    ))}
                  </div>
                ) : field.type === 'multiple' ? (
                  <div class="choice-group">
                    {choicesFor(field).map((option: string) => (
                      <label class="choice-option"><input type="checkbox" name={field.key} value={option} /><span>{option}</span></label>
                    ))}
                  </div>
                ) : field.type === 'checkbox' || field.type === 'terms' ? (
                  <label class="check-option"><input id={field.key} name={field.key} type="checkbox" value="true" required={field.required} /><span>{field.options?.text || field.label}</span></label>
                ) : field.type === 'phone' || /phone|telefono|teléfono|whatsapp|celular/i.test(`${field.key} ${field.label}`) ? (
                  <div class="phone-input"><span>PE&nbsp; +51⌄</span><input id={field.key} name={field.key} type="tel" inputmode="tel" required={field.required} placeholder="987 654 321" class="form-input" /></div>
                ) : (
                  <input
                    id={field.key}
                    name={field.key}
                    type={field.type === 'email' ? 'email' : field.type === 'phone' ? 'tel' : 'text'}
                    required={field.required}
                    placeholder={field.type === 'email' ? 'ejemplo@correo.com' : 'Ingresa tu información'}
                    class="form-input"
                    data-email-field={field.key === 'email' ? 'true' : undefined}
                    aria-describedby={field.key === 'email' ? 'email-availability' : undefined}
                  />
                )}
                {field.options?.helpText && <small class="field-help">{field.options.helpText}</small>}
                {field.key === 'email' && <small id="email-availability" class="field-help email-availability" aria-live="polite"></small>}
                </>}
              </div>
            ))}
          </div>

          <div class="form-submit-wrap">
            <button type="submit" class="submit-btn" id="submit-btn">
              <span>Confirmar y Enviar Inscripción</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14"/>
                <path d="m12 5 7 7-7 7"/>
              </svg>
            </button>
            <p id="form-status" class="form-status" role="status"></p>
          </div>
        </form>
        <div id="registration-success" class="registration-success" hidden>
          <span class="reg-badge">INSCRIPCIÓN CONFIRMADA</span><h2>Gracias por inscribirte</h2><p>Tu registro fue recibido correctamente. Revisa tu correo para próximas novedades.</p>
          <div><a href={`/${institution}/events/${form.mainEventId || ''}`}>Volver al detalle del evento</a><a href={`/${institution}`}>Explorar otro evento</a></div>
        </div>
      </div>
    </div>
  </section>
</PortalLayout>

<script>
  const form = document.querySelector('#registration-form') as HTMLFormElement | null;
  const status = document.querySelector('#form-status') as HTMLParagraphElement | null;
  const submitBtn = document.querySelector('#submit-btn') as HTMLButtonElement | null;
  const emailInput = document.querySelector('[data-email-field="true"]') as HTMLInputElement | null;
  const emailAvailability = document.querySelector('#email-availability') as HTMLElement | null;
  let emailCheckTimer: ReturnType<typeof setTimeout> | undefined;
  let checkedEmail = '';
  let emailIsAvailable = false;

  const setEmailAvailability = (message: string, state = '') => {
    if (!emailAvailability) return;
    emailAvailability.textContent = message;
    emailAvailability.className = `field-help email-availability ${state}`;
  };

  const checkEmailAvailability = async () => {
    const email = emailInput?.value.trim().toLowerCase() || '';
    if (!email) {
      checkedEmail = '';
      emailIsAvailable = false;
      setEmailAvailability('');
      return false;
    }
    if (!emailInput?.validity.valid) {
      checkedEmail = email;
      emailIsAvailable = false;
      setEmailAvailability('Ingresa un correo electrónico válido.', 'unavailable');
      return false;
    }
    setEmailAvailability('Verificando disponibilidad…', 'checking');
    try {
      const response = await fetch(`${form?.dataset.api}/public/registration-forms/${form?.dataset.slug}/email-availability?email=${encodeURIComponent(email)}`);
      const result = await response.json().catch(() => ({}));
      checkedEmail = email;
      emailIsAvailable = response.ok && result.available === true;
      setEmailAvailability(
        emailIsAvailable ? '✓ Correo disponible para este formulario.' : 'Este correo ya está registrado en este formulario.',
        emailIsAvailable ? 'available' : 'unavailable',
      );
      return emailIsAvailable;
    } catch {
      checkedEmail = email;
      emailIsAvailable = false;
      setEmailAvailability('No se pudo validar el correo. Inténtalo nuevamente.', 'unavailable');
      return false;
    }
  };

  emailInput?.addEventListener('input', () => {
    emailIsAvailable = false;
    checkedEmail = '';
    if (emailCheckTimer) clearTimeout(emailCheckTimer);
    const email = emailInput.value.trim();
    if (!email) {
      setEmailAvailability('');
      return;
    }
    setEmailAvailability('Verificando disponibilidad…', 'checking');
    emailCheckTimer = setTimeout(() => void checkEmailAvailability(), 450);
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const currentEmail = emailInput?.value.trim().toLowerCase() || '';
    if (emailInput && (checkedEmail !== currentEmail || !emailIsAvailable)) {
      const isAvailable = await checkEmailAvailability();
      if (!isAvailable) return;
    }
    const rawValues = new FormData(form);
    const values: Record<string, string | string[]> = {};
    rawValues.forEach((value, key) => {
      const current = values[key];
      values[key] = current === undefined ? String(value) : Array.isArray(current) ? [...current, String(value)] : [current, String(value)];
    });
    if (submitBtn) submitBtn.disabled = true;
    if (status) {
      status.textContent = 'Enviando tu inscripción…';
      status.className = 'form-status loading';
    }

    try {
      const response = await fetch(`${form.dataset.api}/public/registration-forms/${form.dataset.slug}/submissions`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ answers: values }),
      });

      if (!response.ok) {
        const errData = await response.json().catch(() => ({}));
        throw new Error(errData.message || 'No se pudo procesar la inscripción');
      }

      const submitted = await response.json().catch(() => ({}));
      if (submitted.thankYouRedirectUrl) { window.location.assign(submitted.thankYouRedirectUrl); return; }
      const eventId = submitted.mainEventId || "";
      const query = new URLSearchParams();
      if (eventId) query.set('eventId', eventId);
      if (submitted.registration?.accessToken) query.set('token', submitted.registration.accessToken);
      window.location.assign(`/${window.location.pathname.split('/').filter(Boolean).slice(0, 3).join('/')}/success${query.size ? `?${query}` : ""}`);
      if (status) {
        status.textContent = '¡Inscripción confirmada con éxito! Te hemos enviado los detalles por correo.';
        status.className = 'form-status success';
      }
    } catch (error) {
      if (status) {
        status.textContent = error instanceof Error ? error.message : 'Ocurrió un error al enviar el registro.';
        status.className = 'form-status error';
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>

<style>
  .reg-page-wrap {
    background: #0c0e12;
    min-height: calc(100vh - 72px);
    padding: 3.5rem 4vw 6rem;
    color: #f1f5f9;
  }
  .reg-container {
    max-width: 680px;
    margin: 0 auto;
  }
  .reg-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #94a3b8;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    margin-bottom: 1.5rem;
    transition: color 0.15s;
  }
  .reg-back-link:hover {
    color: #ffffff;
  }

  .reg-form-card {
    background: #11141a;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 3rem;
    box-shadow: 0 16px 40px -10px rgba(0, 0, 0, 0.5);
  }
  .registration-success { text-align: center; padding: 2rem 0; }
  .registration-success h2 { font-size: 2rem; font-weight: 500; margin: .5rem 0; }
  .registration-success p { color: #94a3b8; line-height: 1.6; }
  .registration-success div { display: flex; justify-content: center; flex-wrap: wrap; gap: .75rem; margin-top: 1.5rem; }
  .registration-success a { border: 1px solid rgba(255,255,255,.2); color: #fff; text-decoration: none; padding: .7rem 1rem; border-radius: .5rem; font-weight: 500; }
  .reg-card-header {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }
  .reg-badge {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: #818cf8;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  .reg-title {
    font-family: 'Inter', sans-serif;
    font-size: 2.2rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 0.75rem;
  }
  .reg-desc {
    font-size: 0.95rem;
    color: #94a3b8;
    line-height: 1.6;
  }

  .form-fields-grid {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    margin-bottom: 2rem;
  }
  .form-field-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .embedded-heading { font-family: 'Inter', sans-serif; font-size: 1.45rem; font-weight: 600; line-height: 1.25; color: #ffffff; }
  .embedded-paragraph { color: #94a3b8; font-size: 0.94rem; line-height: 1.65; }
  .embedded-image { width: 100%; max-height: 280px; object-fit: cover; border-radius: 12px; }
  .embedded-divider { width: 100%; border: 0; border-top: 1px solid rgba(255,255,255,.12); }
  .field-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: #e2e8f0;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .req-star {
    color: #f87171;
  }
  .field-help { color: #94a3b8; font-size: 0.78rem; line-height: 1.4; }
  .email-availability.available { color: #34d399; }
  .email-availability.unavailable { color: #f87171; }
  .email-availability.checking { color: #818cf8; }
  .choice-group { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .choice-option, .check-option { display: flex; gap: 0.65rem; align-items: center; color: #dbe4ef; font-size: 0.9rem; line-height: 1.45; cursor: pointer; }
  .choice-option { border: 1px solid rgba(255,255,255,.18); border-radius: 999px; padding: .65rem 1rem; }
  .choice-option:has(input:checked) { background: #818cf8; border-color: #818cf8; color: #fff; }
  .choice-option input, .check-option input { margin: 0; accent-color: #818cf8; border: 0; }
  .phone-input { display:flex; border:1px solid rgba(255,255,255,.14); border-radius:10px; overflow:hidden; background:#0c0e12; }.phone-input span { display:flex;align-items:center;padding:0 1rem;border-right:1px solid rgba(255,255,255,.14);font-size:.85rem;white-space:nowrap; }.phone-input .form-input { border:0; border-radius:0; }

  .form-input {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    padding: 0.8rem 1rem;
    font-family: inherit;
    font-size: 0.92rem;
    color: #ffffff;
    background: #0c0e12;
    transition: border-color 0.15s, box-shadow 0.15s;
    outline: none;
  }
  .form-input:focus {
    border-color: #818cf8;
    box-shadow: 0 0 0 3px rgba(129, 140, 248, 0.2);
  }
  .form-input.textarea {
    min-height: 120px;
    resize: vertical;
  }
  .form-input.select {
    cursor: pointer;
  }

  .form-submit-wrap {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: #ffffff;
    color: #000000;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.95rem 1.8rem;
    border-radius: 12px;
    border: none;
    cursor: pointer;
    transition: background 0.15s, transform 0.15s;
    width: 100%;
  }
  .submit-btn:hover {
    background: #e2e8f0;
    transform: translateY(-2px);
  }
  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .form-status {
    font-size: 0.9rem;
    font-weight: 600;
    min-height: 1.5rem;
    text-align: center;
  }
  .form-status.loading {
    color: #818cf8;
  }
  .form-status.success {
    color: #34d399;
    padding: 0.85rem;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 8px;
  }
  .form-status.error {
    color: #f87171;
    padding: 0.85rem;
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.25);
    border-radius: 8px;
  }

  @media (max-width: 640px) {
    .reg-form-card {
      padding: 1.75rem;
    }
  }
  :global(html:not(.dark)) .reg-page-wrap { background: #f8fafc; color: #172033; }
  :global(html:not(.dark)) .reg-form-card { background: #ffffff; border-color: #dce4ee; box-shadow: none; }
  :global(html:not(.dark)) .reg-card-header, :global(html:not(.dark)) .embedded-divider { border-color: #e2e8f0; }
  :global(html:not(.dark)) .reg-title, :global(html:not(.dark)) .field-label, :global(html:not(.dark)) .embedded-heading { color: #172033; }
  :global(html:not(.dark)) .reg-desc, :global(html:not(.dark)) .embedded-paragraph, :global(html:not(.dark)) .field-help { color: #52637a; }
  :global(html:not(.dark)) .email-availability.available { color: #047857; }
  :global(html:not(.dark)) .email-availability.unavailable { color: #b91c1c; }
  :global(html:not(.dark)) .form-input { background: #ffffff; border-color: #cfd9e6; color: #172033; }
  :global(html:not(.dark)) .choice-option, :global(html:not(.dark)) .check-option { color: #334155; }
  :global(html:not(.dark)) .choice-option { border-color:#d7e0ea; }:global(html:not(.dark)) .phone-input { background:#fff;border-color:#cfd9e6; }:global(html:not(.dark)) .phone-input span { border-color:#cfd9e6; }
</style>
