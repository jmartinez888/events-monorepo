# ============================================
# Events Portal - Production Dockerfile
# Astro SSR + React + TailwindCSS
# ============================================

# --- Stage 1: Dependencies ---
FROM node:22-alpine AS deps
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/events-portal/package.json ./apps/events-portal/package.json

RUN pnpm install --frozen-lockfile

# --- Stage 2: Build ---
FROM node:22-alpine AS build
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/events-portal/node_modules ./apps/events-portal/node_modules
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/events-portal ./apps/events-portal

ARG PUBLIC_API_URL
ENV PUBLIC_API_URL=${PUBLIC_API_URL}

WORKDIR /app/apps/events-portal
RUN pnpm run build

# --- Stage 3: Runner ---
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4321

# Add dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Create non-root user
RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 appuser

# Copy the Astro standalone build output
COPY --from=build --chown=appuser:nodejs /app/apps/events-portal/dist ./dist

USER appuser

EXPOSE 4321

CMD ["dumb-init", "node", "./dist/server/entry.mjs"]
