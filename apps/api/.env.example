DATABASE_URL=postgresql://events:events@localhost:5432/events?schema=public
PORT=3000
FRONTEND_URL=https://dev-qa.nuiti.org,https://medmind.com.pe,http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:3001,http://127.0.0.1:5173,http://127.0.0.1:5174
JWT_ACCESS_SECRET=replace-with-a-long-secret
JWT_REFRESH_SECRET=replace-with-another-long-secret
APP_NAME=Events Platform
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@example.com
RESEND_FROM_NAME=Events Platform

# --- Seguridad (obligatorias en producción: la API no arranca sin ellas) ---
# Cifra los secretos TOTP y credenciales de integraciones. Si se pierde, los 2FA por app dejan de validar.
ENCRYPTION_KEY=replace-with-a-long-random-value
# Firma las URLs temporales de descarga de materiales y documentos.
FILE_URL_SECRET=replace-with-a-long-random-value
# false desactiva el autoregistro público (las cuentas solo las crea un SUPER_ADMIN).
ALLOW_PUBLIC_SIGNUP=true
# Detrás de un proxy inverso (nginx, Traefik) para registrar la IP real.
TRUST_PROXY=
# URLs públicas usadas en correos y enlaces firmados.
API_PUBLIC_URL=http://localhost:3000/api
PORTAL_URL=http://localhost:4321
# Solo un tenant (IIAP): permite usar el correo global si la organización no tiene uno propio.
MAIL_SYSTEM_FALLBACK=false

# --- Almacenamiento de archivos: local | minio | s3 | r2 ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
FILE_MAX_MB=50

# --- Zoom (app Server-to-Server OAuth; el reporte de asistencia exige plan Pro o superior) ---
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_ID=me
ZOOM_WEBHOOK_SECRET=
ZOOM_AUTO_RECORDING=none

# --- Facebook Live (token de Página de larga duración con publish_video) ---
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v21.0

# --- Sistema de Asistencia (attendance-control) ---
ATTENDANCE_API_URL=
ATTENDANCE_API_TOKEN=
ATTENDANCE_WEBHOOK_SECRET=
ATTENDANCE_SERVICE_KEY=

# --- Sistema de Certificados (sin estas variables se emite y verifica localmente) ---
CERTIFICATES_API_URL=
CERTIFICATES_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- Trabajadores en segundo plano (false en procesos que no deben despachar) ---
INTEGRATION_WORKER=true
NOTIFICATIONS_WORKER=true
