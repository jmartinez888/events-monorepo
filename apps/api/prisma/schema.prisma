  profileId         String              @unique @map("profile_id") @db.Uuid
  channel           NotificationChannel @default(EMAIL)
  remindersEnabled  Boolean             @default(true) @map("reminders_enabled")
  telegramChatId    String?             @map("telegram_chat_id")
  telegramLinkedAt  DateTime?           @map("telegram_linked_at")
  /// Token del deep-link del bot; se rota al enlazar.
  telegramLinkToken String              @unique @default(uuid()) @map("telegram_link_token") @db.Uuid
  updatedAt         DateTime            @updatedAt @map("updated_at")
  profile           Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// Confirmaciones y recordatorios de eventos. La clave de idempotencia evita enviar dos veces lo mismo.
model Notification {
  id             String               @id @default(uuid()) @db.Uuid
  profileId      String               @map("profile_id") @db.Uuid
  participantId  String?              @map("participant_id") @db.Uuid
  mainEventId    String               @map("main_event_id") @db.Uuid
  sessionId      String?              @map("session_id") @db.Uuid
  type           String
  channel        NotificationChannel?
  status         NotificationStatus   @default(SCHEDULED)
  scheduledFor   DateTime             @map("scheduled_for")
  sentAt         DateTime?            @map("sent_at")
  attempts       Int                  @default(0)
  lockedAt       DateTime?            @map("locked_at")
  lastError      String?              @map("last_error")
  idempotencyKey String               @unique @map("idempotency_key")
  createdAt      DateTime             @default(now()) @map("created_at")
  profile        Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  participant    EventParticipant?    @relation(fields: [participantId], references: [id], onDelete: Cascade)
  event          MainEvent            @relation(fields: [mainEventId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([participantId])
  @@map("notifications")
}

/// Material de exposición (sesión/expositor) o documento del evento (acta, programa…).
model EventFile {
  id               String             @id @default(uuid()) @db.Uuid
  mainEventId      String             @map("main_event_id") @db.Uuid
  scope            FileScope
  sessionId        String?            @map("session_id") @db.Uuid
  sessionSpeakerId String?            @map("session_speaker_id") @db.Uuid
  documentType     String?            @map("document_type")
  title            String
  visibility       FileVisibility     @default(PRIVATE)
  status           FileStatus         @default(ACTIVE)
  currentVersion   Int                @default(1) @map("current_version")
  createdBy        String?            @map("created_by") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  event            MainEvent          @relation(fields: [mainEventId], references: [id], onDelete: Cascade)
  session          EventSession?      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speaker          SessionSpeaker?    @relation(fields: [sessionSpeakerId], references: [id], onDelete: SetNull)
  versions         EventFileVersion[]

  @@index([mainEventId, scope, status])
  @@index([sessionId])
  @@map("event_files")
}

/// Cada reemplazo crea una versión; el binario vive en el storage, aquí solo la clave.
model EventFileVersion {
  id         String    @id @default(uuid()) @db.Uuid
  fileId     String    @map("file_id") @db.Uuid
  version    Int
  storageKey String    @map("storage_key")
  fileName   String    @map("file_name")
  mimeType   String    @map("mime_type")
  size       Int
  sha256     String
  uploadedBy String?   @map("uploaded_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  file       EventFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, version])
  @@map("event_file_versions")
}

/// Posible duplicado del Directorio: la inscripción sigue con un perfil provisional
/// y un administrador decide si fusionarlo con una persona existente.
model DirectoryReview {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String?   @map("organization_id") @db.Uuid
  reason               String
  /// Perfil creado para no bloquear la inscripción.
  provisionalProfileId String    @map("provisional_profile_id") @db.Uuid
  candidateProfileIds  String[]  @map("candidate_profile_ids") @db.Uuid
  submitted            Json
  status               String    @default("OPEN")
  resolution           String?
  resolvedBy           String?   @map("resolved_by") @db.Uuid
  resolvedAt           DateTime? @map("resolved_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([organizationId, status])
  @@map("directory_reviews")
}
