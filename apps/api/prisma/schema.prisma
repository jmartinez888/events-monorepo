generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  FINISHED
}

enum EventMode {
  PHYSICAL
  ONLINE
  HYBRID
}

enum MemberRole {
  OWNER
  ADMIN
  EDITOR
  MEMBER
}

enum GlobalRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum AccountPlan {
  FREE
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum CertificateStatus {
  PENDING
  ISSUED
  FAILED
  REVOKED
  SUPERSEDED
}

/// Segundo factor elegido por la persona. Es opcional para todas las cuentas.
enum TwoFactorMethod {
  TOTP
  EMAIL
}

/// Motivo de un código de 6 dígitos enviado por correo.
enum VerificationPurpose {
  EMAIL_VERIFY
  LOGIN_2FA
  ENABLE_2FA
}

enum RegistrationStatus {
  PREREGISTERED
  CONFIRMED
  WAITLISTED
  CANCELLED
}

/// Canal por el que la inscripción llegó al sistema.
enum RegistrationOrigin {
  FORM
  MANUAL
  SPEAKER
  OPEN_REGISTRATION
  ONSITE
  IMPORT
}

enum VirtualAttendanceMode {
  MANUAL
  AUTOMATIC
}

enum SyncStatus {
  DISABLED
  PENDING
  SYNCED
  ERROR
}

enum SessionSpeakerRole {
  SPEAKER
  CO_SPEAKER
  MODERATOR
}

enum NotificationChannel {
  EMAIL
  TELEGRAM
}

enum NotificationStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
  SKIPPED
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum FileScope {
  MATERIAL
  DOCUMENT
}

enum FileVisibility {
  PUBLIC
  REGISTERED
  PRIVATE
}

enum FileStatus {
  ACTIVE
  HIDDEN
  DELETED
}

enum RegistrationFormStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum RegistrationSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MarketingConsentStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
  PENDING_CONFIRMATION
}

enum EmailTemplateStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TemplateChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AutomationTiming {
  IMMEDIATE
  BEFORE_EVENT
  AFTER_EVENT
  AFTER_PREVIOUS_STEP
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
  SKIPPED
}

/// Tipo de entidad que puede reutilizar un recurso multimedia.
enum MediaOwnerType {
  ORGANIZATION
  EVENT
  EDITION
  PROFILE
}

/// Uso visual del recurso dentro de una entidad. Un mismo archivo puede tener varios usos.
enum MediaPurpose {
  COVER
  LOGO
  GALLERY
  DOCUMENT
  OTHER
}

enum MediaOrientation {
  LANDSCAPE
  PORTRAIT
  SQUARE
  VIDEO
  OTHER
}

model AuthUser {
  id                     String               @id @default(uuid()) @db.Uuid
  email                  String               @unique
  passwordHash           String               @map("password_hash")
  role                   GlobalRole           @default(USER)
  plan                   AccountPlan          @default(FREE)
  isActive               Boolean              @default(true) @map("is_active")
  emailVerifiedAt        DateTime?            @map("email_verified_at")
  passwordResetTokenHash String?              @map("password_reset_token_hash")
  passwordResetExpiresAt DateTime?            @map("password_reset_expires_at")
  /// Secreto TOTP cifrado con AES-256-GCM; existe desde la configuración, se usa al activar.
  totpSecretEnc          String?              @map("totp_secret_enc")
  /// Último paso TOTP aceptado: impide reutilizar un código dentro de su ventana.
  totpLastStep           Int?                 @map("totp_last_step")
  twoFactorMethod        TwoFactorMethod?     @map("two_factor_method")
  twoFactorEnabledAt     DateTime?            @map("two_factor_enabled_at")
  /// Se incrementa al cambiar contraseña, rol o 2FA: invalida los refresh tokens emitidos.
  sessionVersion         Int                  @default(0) @map("session_version")
  lastLoginAt            DateTime?            @map("last_login_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  profile                Profile?
  memberships            OrganizationMember[]
  verificationCodes      VerificationCode[]
  recoveryCodes          RecoveryCode[]
  securityEvents         SecurityEvent[]

  @@map("auth_users")
}

/// Código de 6 dígitos enviado por correo. Solo se guarda su HMAC.
model VerificationCode {
  id         String              @id @default(uuid()) @db.Uuid
  accountId  String              @map("account_id") @db.Uuid
  purpose    VerificationPurpose
  codeHash   String              @map("code_hash")
  attempts   Int                 @default(0)
  expiresAt  DateTime            @map("expires_at")
  consumedAt DateTime?           @map("consumed_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  account    AuthUser            @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose, createdAt])
  @@map("verification_codes")
}

/// Códigos de recuperación del segundo factor. Un solo uso cada uno.
model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  account   AuthUser  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("recovery_codes")
}

/// Bitácora de seguridad de la cuenta (accesos, 2FA, contraseña).
model SecurityEvent {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String?   @map("account_id") @db.Uuid
  action    String
  ip        String?
  details   Json?
  createdAt DateTime  @default(now()) @map("created_at")
  account   AuthUser? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@map("security_events")
}

model Profile {
  id                     String                  @id @default(uuid()) @db.Uuid
  authUserId             String?                 @unique @map("auth_user_id") @db.Uuid
  organizationId         String?                 @map("organization_id") @db.Uuid
  firstName              String?                 @map("first_name")
  lastName               String?                 @map("last_name")
  phone                  String?
  primaryEmail           String?                 @map("primary_email")
  avatarUrl              String?                 @map("avatar_url")
  bio                    String?
  identityDocumentType   String?                 @map("identity_document_type")
  identityDocumentNumber String?                 @map("identity_document_number")
  birthDate              DateTime?               @map("birth_date")
  sex                    String?
  location               String?
  institution            String?
  dedication             String?
  researchInterests      String?                 @map("research_interests")
  areasOfInterest        String[]                @default([]) @map("areas_of_interest")
  expertiseAreas         String[]                @default([]) @map("expertise_areas")
  socialLinks            Json?                   @map("social_links")
  additionalEmails       Json?                   @map("additional_emails")
  isPublic               Boolean                 @default(false) @map("is_public")
  onboardingCompleted    Boolean                 @default(false) @map("onboarding_completed")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  authUser               AuthUser?               @relation(fields: [authUserId], references: [id], onDelete: SetNull)
  organization           Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  memberships            OrganizationMember[]
  education              Education[]
  employment             EmploymentHistory[]
  certifications         Certification[]
  participants           EventParticipant[]
  sessionSpeakers        SessionSpeaker[]
  marketingContacts      MarketingContact[]
  notificationPreference NotificationPreference?
  notifications          Notification[]

  @@index([primaryEmail])
  @@index([identityDocumentType, identityDocumentNumber])
  @@map("profiles")
}

model Organization {
  id                   String                     @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String                     @unique
  description          String?
  organizationType     String?                    @map("organization_type")
  logoUrl              String?                    @map("logo_url")
  coverUrl             String?                    @map("cover_url")
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")
  isActive             Boolean                    @default(true) @map("is_active")
  members              OrganizationMember[]
  profiles             Profile[]
  branches             OrganizationBranch[]
  events               MainEvent[]
  subscription         OrganizationSubscription?
  emailTemplates       EmailTemplate[]
  emailSections        EmailSection[]
  emailSettings        OrganizationEmailSettings?
  marketingContacts    MarketingContact[]
  marketingSegments    MarketingSegment[]
  marketingCampaigns   MarketingCampaign[]
  automations          MarketingAutomation[]
  emailDeliveries      EmailDelivery[]
  marketingEnrollments MarketingEventEnrollment[]
  portal               OrganizationPortal?
  mediaAssets          MediaAsset[]

  @@map("organizations")
}

model MarketingContact {
  id             String                     @id @default(uuid()) @db.Uuid
  organizationId String                     @map("organization_id") @db.Uuid
  profileId      String?                    @map("profile_id") @db.Uuid
  emailFallback  String?                    @map("email_fallback")
  consentStatus  MarketingConsentStatus     @default(PENDING_CONFIRMATION) @map("consent_status")
  consentedAt    DateTime?                  @map("consented_at")
  unsubscribedAt DateTime?                  @map("unsubscribed_at")
  source         String                     @default("MANUAL")
  tags           String[]                   @default([])
  createdAt      DateTime                   @default(now()) @map("created_at")
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        Profile?                   @relation(fields: [profileId], references: [id], onDelete: SetNull)
  segmentMembers MarketingSegmentMember[]
  enrollments    MarketingEventEnrollment[]

  @@unique([organizationId, profileId])
  @@unique([organizationId, emailFallback])
  @@index([organizationId, emailFallback])
  @@map("marketing_contacts")
}

model MarketingSegment {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  name           String
  description    String?
  type           String                   @default("MANUAL")
  rules          Json?
  createdAt      DateTime                 @default(now()) @map("created_at")
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        MarketingSegmentMember[]

  @@unique([organizationId, name])
  @@map("marketing_segments")
}

model MarketingSegmentMember {
  segmentId String           @map("segment_id") @db.Uuid
  contactId String           @map("contact_id") @db.Uuid
  addedAt   DateTime         @default(now()) @map("added_at")
  segment   MarketingSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  contact   MarketingContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([segmentId, contactId])
  @@map("marketing_segment_members")
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  profileId      String       @map("profile_id") @db.Uuid
  accountId      String?      @map("account_id") @db.Uuid
  role           MemberRole   @default(MEMBER)
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  account        AuthUser?    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([organizationId, profileId])
  @@unique([organizationId, accountId])
  @@map("organization_members")
}

model OrganizationSubscription {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @unique @map("organization_id") @db.Uuid
  plan           AccountPlan        @default(FREE)
  status         SubscriptionStatus @default(ACTIVE)
  startsAt       DateTime           @default(now()) @map("starts_at")
  renewsAt       DateTime?          @map("renews_at")
  endsAt         DateTime?          @map("ends_at")
  provider       String?
  providerRef    String?            @map("provider_ref")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_subscriptions")
}

model OrganizationBranch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  isMain         Boolean      @default(false) @map("is_main")
  department     String?
  province       String?
  district       String?
  address        String?
  reference      String?
  latitude       Float?
  longitude      Float?
  contactPhones  String[]     @default([]) @map("contact_phones")
  contactEmails  String[]     @default([]) @map("contact_emails")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_branches")
}

model MainEvent {
  id                      String                     @id @default(uuid()) @db.Uuid
  organizationId          String?                    @map("organization_id") @db.Uuid
  eventName               String                     @map("event_name")
  description             String?
  status                  EventStatus                @default(DRAFT)
  eventMode               EventMode?                 @map("event_mode")
  startDate               DateTime                   @map("start_date")
  endDate                 DateTime?                  @map("end_date")
  coverUrl                String?                    @map("cover_url")
  logoUrl                 String?                    @map("logo_url")
  contactEmail            String?                    @map("contact_email")
  whatsappCommunityUrl    String?                    @map("whatsapp_community_url")
  /// MANUAL: el organizador aprueba la asistencia virtual; AUTOMATIC: se importa el reporte de Zoom.
  virtualAttendanceMode   VirtualAttendanceMode      @default(MANUAL) @map("virtual_attendance_mode")
  /// Fracción mínima de permanencia (0..1) para que la asistencia virtual sea válida.
  attendanceThreshold     Float                      @default(0.8) @map("attendance_threshold")
  /// Aforo por edición; nulo significa sin límite.
  capacity                Int?
  waitlistEnabled         Boolean                    @default(false) @map("waitlist_enabled")
  /// Minutos antes del inicio de cada sesión en que se envía un recordatorio.
  reminderOffsets         Int[]                      @default([60]) @map("reminder_offsets")
  /// Crea reunión de Zoom (y registrant por inscrito) para sesiones virtuales.
  zoomEnabled             Boolean                    @default(false) @map("zoom_enabled")
  facebookLiveEnabled     Boolean                    @default(false) @map("facebook_live_enabled")
  /// Replica el evento en el sistema externo de Asistencia (QR presencial).
  attendanceMirrorEnabled Boolean                    @default(false) @map("attendance_mirror_enabled")
  venueAddress            String?                    @map("venue_address")
  latitude                Float?
  longitude               Float?
  createdAt               DateTime                   @default(now()) @map("created_at")
  updatedAt               DateTime                   @updatedAt @map("updated_at")
  organization            Organization?              @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  editions                Edition[]
  details                 EventDetail?
  thematicLines           ThematicLine[]
  setupProgress           EventSetupProgress?
  contacts                EventContact[]
  registrationForms       RegistrationForm[]
  automations             MarketingAutomation[]
  marketingEnrollments    MarketingEventEnrollment[]
  files                   EventFile[]
  notifications           Notification[]

  @@index([organizationId, status])
  @@map("main_events")
}

model EventSetupProgress {
  id                 String    @id @default(uuid()) @db.Uuid
  eventId            String    @unique @map("event_id") @db.Uuid
  basicInfoCompleted Boolean   @default(false) @map("basic_info_completed")
  rolesCompleted     Boolean   @default(false) @map("roles_completed")
  editionCompleted   Boolean   @default(false) @map("edition_completed")
  peopleCompleted    Boolean   @default(false) @map("people_completed")
  contactCompleted   Boolean   @default(false) @map("contact_completed")
  completed          Boolean   @default(false)
  currentStep        Int       @default(1) @map("current_step")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  event              MainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_setup_progress")
}

model EventContact {
  id        String    @id @default(uuid()) @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  name      String
  email     String?
  phone     String?
  role      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  event     MainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_contacts")
}

model EventDetail {
  id          Int       @id @default(autoincrement())
  eventId     String    @unique @map("event_id") @db.Uuid
  content     String?
  socialLinks Json?     @map("social_links")
  media       Json?
  sponsors    Json?
  faqs        Json?
  event       MainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_details")
}

model Edition {
  id                String             @id @default(uuid()) @db.Uuid
  mainEventId       String             @map("main_event_id") @db.Uuid
  name              String
  startDate         DateTime?          @map("start_date")
  endDate           DateTime?          @map("end_date")
  modality          String?
  location          String?
  description       String?
  coverUrl          String?            @map("cover_url")
  metaThumbnailUrl  String?            @map("meta_thumbnail_url")
  isCurrent         Boolean            @default(false) @map("is_current")
  latitude          Float?
  longitude         Float?
  createdAt         DateTime           @default(now()) @map("created_at")
  mainEvent         MainEvent          @relation(fields: [mainEventId], references: [id], onDelete: Cascade)
  activities        EventActivity[]
  participants      EventParticipant[]
  tickets           EventTicket[]
  registrationForms RegistrationForm[]

  @@index([mainEventId])
  @@map("editions")
}

/// Archivo físico almacenado una única vez. La clave permite borrarlo del proveedor
/// sin inferirla a partir de la URL pública.
model MediaAsset {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String?          @map("organization_id") @db.Uuid
  key            String           @unique
  url            String           @unique
  filename       String           @map("file_name")
  mimeType       String           @map("mime_type")
  sizeBytes      Int              @map("size_bytes")
  orientation    MediaOrientation @default(OTHER)
  createdAt      DateTime         @default(now()) @map("created_at")
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  links          MediaLink[]

  @@index([organizationId, createdAt])
  @@map("media_assets")
}

/// Asociación polimórfica: el mismo archivo se puede reutilizar en una organización,
/// evento o edición sin duplicar datos ni volver a subirlo.
model MediaLink {
  id         String         @id @default(uuid()) @db.Uuid
  mediaId    String         @map("media_id") @db.Uuid
  ownerType  MediaOwnerType @map("owner_type")
  ownerId    String         @map("owner_id") @db.Uuid
  purpose    MediaPurpose   @default(GALLERY)
  position   Int            @default(0)
  isFeatured Boolean        @default(false) @map("is_featured")
  createdAt  DateTime       @default(now()) @map("created_at")
  media      MediaAsset     @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, ownerType, ownerId, purpose])
  @@index([ownerType, ownerId, purpose, position])
  @@map("media_links")
}

model RegistrationForm {
  id                    String                   @id @default(uuid()) @db.Uuid
  mainEventId           String                   @map("main_event_id") @db.Uuid
  editionId             String?                  @map("edition_id") @db.Uuid
  title                 String
  description           String?
  slug                  String                   @unique
  status                RegistrationFormStatus   @default(DRAFT)
  opensAt               DateTime?                @map("opens_at")
  closesAt              DateTime?                @map("closes_at")
  maxSubmissions        Int?                     @map("max_submissions")
  approvalMode          String                   @default("MANUAL") @map("approval_mode")
  purpose               String                   @default("PARTICIPANT")
  allowEditionSelection Boolean                  @default(false) @map("allow_edition_selection")
  defaultEditionId      String?                  @map("default_edition_id") @db.Uuid
  thankYouMessage       String?                  @map("thank_you_message")
  thankYouRedirectUrl   String?                  @map("thank_you_redirect_url")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  mainEvent             MainEvent                @relation(fields: [mainEventId], references: [id], onDelete: Cascade)
  edition               Edition?                 @relation(fields: [editionId], references: [id], onDelete: SetNull)
  fields                RegistrationFormField[]
  submissions           RegistrationSubmission[]
  automations           MarketingAutomation[]

  @@index([mainEventId])
  @@map("registration_forms")
}

model RegistrationFormField {
  id         String           @id @default(uuid()) @db.Uuid
  formId     String           @map("form_id") @db.Uuid
  key        String
  label      String
  type       String
  required   Boolean          @default(false)
  options    Json?
  validation Json?
  position   Int              @default(0)
  form       RegistrationForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, key])
  @@map("registration_form_fields")
}

model RegistrationSubmission {
  id                  String                       @id @default(uuid()) @db.Uuid
  formId              String                       @map("form_id") @db.Uuid
  editionId           String?                      @map("edition_id") @db.Uuid
  status              RegistrationSubmissionStatus @default(PENDING)
  email               String?
  answers             Json
  profileId           String?                      @map("profile_id") @db.Uuid
  participantId       String?                      @map("participant_id") @db.Uuid
  submittedAt         DateTime                     @default(now()) @map("submitted_at")
  reviewedAt          DateTime?                    @map("reviewed_at")
  form                RegistrationForm             @relation(fields: [formId], references: [id], onDelete: Cascade)
  marketingEnrollment MarketingEventEnrollment?

  @@unique([formId, email])
  @@index([formId, status])
  @@map("registration_submissions")
}

model EventActivity {
  id          String         @id @default(uuid()) @db.Uuid
  editionId   String         @map("event_id") @db.Uuid
  title       String
  description String?
  startsAt    DateTime?      @map("starts_at")
  endsAt      DateTime?      @map("ends_at")
  edition     Edition        @relation(fields: [editionId], references: [id], onDelete: Cascade)
  sessions    EventSession[]

  @@map("event_activities")
}

model EventSession {
  id                String                @id @default(uuid()) @db.Uuid
  activityId        String                @map("activity_id") @db.Uuid
  title             String
  description       String?
  startsAt          DateTime?             @map("starts_at")
  endsAt            DateTime?             @map("ends_at")
  /// Nulo hereda la modalidad del evento.
  modality          EventMode?
  activity          EventActivity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  speakers          SessionSpeaker[]
  resources         SessionResource[]
  thematicLines     SessionThematicLine[]
  attendanceRecords AttendanceRecord[]
  integration       SessionIntegration?
  registrations     SessionRegistration[]
  files             EventFile[]

  @@map("event_sessions")
}

model SessionThematicLine {
  sessionId      String       @map("session_id") @db.Uuid
  thematicLineId String       @map("thematic_line_id") @db.Uuid
  session        EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  thematicLine   ThematicLine @relation(fields: [thematicLineId], references: [id], onDelete: Cascade)

  @@id([sessionId, thematicLineId])
  @@map("session_thematic_lines")
}

model SessionResource {
  id        String       @id @default(uuid()) @db.Uuid
  sessionId String       @map("session_id") @db.Uuid
  name      String
  url       String
  type      String?
  createdAt DateTime     @default(now()) @map("created_at")
  session   EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_resources")
}

model SessionSpeaker {
  id        String             @id @default(uuid()) @db.Uuid
  sessionId String             @map("session_id") @db.Uuid
  profileId String             @map("profile_id") @db.Uuid
  role      SessionSpeakerRole @default(SPEAKER)
  topic     String?
