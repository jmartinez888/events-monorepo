/// Trabajo durable contra un sistema externo. Se reclama con SKIP LOCKED y se reintenta con espera creciente.
model IntegrationJob {
  id          String    @id @default(uuid()) @db.Uuid
  kind        String
  payload     Json
  /// Evita encolar dos veces la misma operación pendiente.
  dedupeKey   String?   @unique @map("dedupe_key")
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  maxAttempts Int       @default(6) @map("max_attempts")
  runAt       DateTime  @default(now()) @map("run_at")
  lockedAt    DateTime? @map("locked_at")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, runAt])
  @@map("integration_jobs")
}

