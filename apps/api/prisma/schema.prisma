model ParticipantCertificate {
  id             String                   @id @default(uuid()) @db.Uuid
  participantId  String                   @map("participant_id") @db.Uuid
  templateId     String?                  @map("template_id") @db.Uuid
  /// Rol certificado. Nulo solo en certificados anteriores a los roles múltiples.
  roleId         String?                  @map("role_id") @db.Uuid
  code           String                   @unique
  status         CertificateStatus        @default(ISSUED)
  /// Una reemisión conserva la versión anterior como SUPERSEDED.
  version        Int                      @default(1)
  /// Clave enviada al sistema de Certificados: repetir la petición no duplica el documento.
  idempotencyKey String?                  @unique @map("idempotency_key")
  externalId     String?                  @map("external_id")
  verifyUrl      String?                  @map("verify_url")
  hours          Int?
  attempts       Int                      @default(0)
  lastError      String?                  @map("last_error")
  issuedBy       String?                  @map("issued_by") @db.Uuid
  issuedAt       DateTime                 @default(now()) @map("issued_at")
  revokedAt      DateTime?                @map("revoked_at")
  revokedReason  String?                  @map("revoked_reason")
  participant    EventParticipant         @relation(fields: [participantId], references: [id], onDelete: Cascade)
  template       CertificateTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  role           ParticipantRole?         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  logs           CertificateTrackingLog[]

  @@index([participantId, roleId, status])
  @@map("participant_certificates")
}

