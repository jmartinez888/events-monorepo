# ============================================
# API - Staging Dockerfile
# NestJS + Prisma | Multi-stage build
# ============================================

# --- Stage 1: Dependencies ---
FROM node:22-alpine AS deps
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/package.json

RUN pnpm install --frozen-lockfile

# --- Stage 2: Build ---
FROM node:22-alpine AS build
WORKDIR /app

RUN apk add --no-cache openssl
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api ./apps/api

WORKDIR /app/apps/api

# Generate Prisma client and build TypeScript
RUN pnpm exec prisma generate --schema prisma/schema.prisma
RUN pnpm run build

# Deploy only production dependencies
RUN pnpm deploy --filter events-api --prod /prod

# Generate Prisma client inside /prod (schema must live in /prod, Prisma resolves @prisma/client from the schema dir)
RUN cp -r /app/apps/api/prisma /prod/prisma \
    && cd /prod \
    && node_modules/.bin/prisma generate --schema prisma/schema.prisma

# --- Stage 3: Runner ---
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=staging

# Add dumb-init for proper signal handling
RUN apk add --no-cache dumb-init openssl

# Create non-root user
RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 appuser

COPY --from=build --chown=appuser:nodejs /prod ./
COPY --from=build --chown=appuser:nodejs /app/apps/api/dist ./dist
COPY --from=build --chown=appuser:nodejs /app/apps/api/prisma ./prisma

USER appuser

EXPOSE 3000

# Run migrations then start the app (using node directly, no npx)
CMD ["dumb-init", "sh", "-c", "node node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma && node dist/main.js"]
