# ============================================
# API - Production Dockerfile
# NestJS + Prisma | Multi-stage build
# ============================================

# --- Stage 1: Dependencies ---
FROM node:22-alpine AS deps
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/package.json

RUN pnpm install --frozen-lockfile

# --- Stage 2: Build ---
FROM node:22-alpine AS build
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api ./apps/api

WORKDIR /app/apps/api

# Generate Prisma client and build TypeScript
RUN pnpm exec prisma generate --schema prisma/schema.prisma
RUN pnpm run build

# Deploy only production dependencies
RUN pnpm deploy --filter events-api --prod /prod

# Copy Prisma client to production
RUN PRISMA_CLIENT_DIR=$(find /app/node_modules -type d -path '*/.prisma/client' | head -n 1) \
    && mkdir -p /prod/node_modules/.prisma \
    && cp -r "$PRISMA_CLIENT_DIR" /prod/node_modules/.prisma/client

# Copy Prisma CLI to production for migrations
RUN mkdir -p /prod/node_modules/prisma \
    && cp -r /app/node_modules/prisma/* /prod/node_modules/prisma/ \
    && mkdir -p /prod/node_modules/@prisma/engines \
    && cp -r /app/node_modules/@prisma/engines/* /prod/node_modules/@prisma/engines/

# --- Stage 3: Runner ---
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

# Add dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Create non-root user
RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 appuser

COPY --from=build --chown=appuser:nodejs /prod ./
COPY --from=build --chown=appuser:nodejs /app/apps/api/dist ./dist
COPY --from=build --chown=appuser:nodejs /app/apps/api/prisma ./prisma

USER appuser

EXPOSE 3000

# Run migrations then start the app (using node directly, no npx)
CMD ["dumb-init", "sh", "-c", "node node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma && node dist/main.js"]
