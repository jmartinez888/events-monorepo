# =============================================================================
# Configuración global del monorepo de Eventos IIAP
# -----------------------------------------------------------------------------
# Lo leen la API (NestJS y Prisma), el panel (Vite) y el portal (Astro).
# Una variable ya definida en el entorno (Docker, CI, terminal) tiene prioridad.
# Copia este archivo a .env y completa los valores. .env no se versiona.
# Solo llegan al navegador las variables VITE_* (panel) y PUBLIC_* (portal):
# nunca pongas secretos con esos prefijos.
# =============================================================================

# --- Entorno -----------------------------------------------------------------
NODE_ENV=development
APP_NAME=Eventos IIAP

# --- Base de datos. En docker-compose.prod/staging, el host es eventos-db y la crean POSTGRES_*.
POSTGRES_DB=eventos
POSTGRES_USER=eventos
POSTGRES_PASSWORD=replace-with-a-long-random-value
DATABASE_URL=postgresql://events:events@localhost:5433/events?schema=public

# --- API -----------------------------------------------------------------------
PORT=3000
# Orígenes permitidos por CORS (panel y portal), separados por comas. El primero se usa en los enlaces de los correos.
FRONTEND_URL=http://localhost:5173,http://localhost:4321,http://127.0.0.1:5173
# URL pública de la API: enlaces de descarga firmados y seguimiento de correos.
API_PUBLIC_URL=http://localhost:3000/api
# URL pública del portal: enlace personal de la inscripción en los correos.
PORTAL_URL=http://localhost:4321
# Detrás de nginx/Traefik: true o número de saltos, para registrar la IP real.
TRUST_PROXY=

# --- Seguridad (en producción la API no arranca sin estas cuatro) -------------
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-long-random-value
# Cifra los secretos TOTP del 2FA y credenciales guardadas. Si se pierde o cambia, los 2FA por app dejan de validar.
ENCRYPTION_KEY=replace-with-a-long-random-value
# Firma las URLs temporales de descarga de materiales y documentos.
FILE_URL_SECRET=replace-with-a-long-random-value
# false: solo un SUPER_ADMIN crea cuentas (sin autoregistro público).
ALLOW_PUBLIC_SIGNUP=true

# --- Correo global por SMTP (prioridad sobre Resend). Gmail/Workspace: puerto 465 y contraseña de aplicación.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Eventos IIAP

# --- Correo (Resend). Sin SMTP ni clave, los correos se simulan en el log de la API
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Eventos IIAP
# Firma de los webhooks de Resend (entregas, rebotes, aperturas).
RESEND_WEBHOOK_SECRET=
# Base de los enlaces de seguimiento de correos; vacío usa API_PUBLIC_URL.
EMAIL_TRACKING_BASE_URL=
# true: si la organización no tiene correo propio configurado, usar el global de arriba.
MAIL_SYSTEM_FALLBACK=true

# --- Almacenamiento de materiales y documentos: local | minio | s3 | r2 -------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Para minio/s3 (bucket privado). Con r2 se usan las credenciales CLOUDFLARE_R2_* y este bucket.
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=
# Carpeta dentro del bucket: production o staging.
STORAGE_S3_PREFIX=
FILE_MAX_MB=50

# --- Biblioteca multimedia (portadas, logos, galería). Bucket con lectura anónima de objetos (sin listado).
# MinIO/S3: usa el endpoint y las credenciales STORAGE_S3_* y la carpeta STORAGE_S3_PREFIX.
MEDIA_S3_BUCKET=
MEDIA_PUBLIC_URL=
# Alternativa: Cloudflare R2 (solo si MEDIA_S3_BUCKET está vacío).
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=

# --- Zoom (app Server-to-Server OAuth; el reporte de asistencia exige plan Pro) -
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_ID=me
ZOOM_WEBHOOK_SECRET=
ZOOM_AUTO_RECORDING=none

# --- Facebook Live (Página con token de larga duración y permiso publish_video)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v21.0

# --- Sistema de Asistencia (attendance-control) --------------------------------
# URL base con /api, ej. https://asistencia.iiap.gob.pe/api
ATTENDANCE_API_URL=
# Token JWT de una cuenta de servicio de Asistencia con rol ADMIN_EVENTO.
ATTENDANCE_API_TOKEN=
# Secretos propios de Eventos: compártelos con el equipo de Asistencia.
ATTENDANCE_WEBHOOK_SECRET=replace-with-a-long-random-value
ATTENDANCE_SERVICE_KEY=replace-with-a-long-random-value

# --- Sistema de Certificados (vacío: Eventos emite y verifica localmente) ----
CERTIFICATES_API_URL=
CERTIFICATES_API_KEY=

# --- Telegram (bot de recordatorios) -------------------------------------------
TELEGRAM_BOT_TOKEN=
# Usuario del bot sin @, para el enlace t.me/<bot>?start=...
TELEGRAM_BOT_USERNAME=
# Úsalo como secret_token al registrar el webhook (setWebhook).
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-value

# --- Trabajadores en segundo plano ---------------------------------------------
# false en réplicas que no deben despachar la cola de integraciones ni las notificaciones.
INTEGRATION_WORKER=true
NOTIFICATIONS_WORKER=true
INTEGRATION_WORKER_INTERVAL_MS=10000
NOTIFICATIONS_WORKER_INTERVAL_MS=30000
RECONCILE_INTERVAL_MS=900000

# --- Primera cuenta SUPER_ADMIN: la crea el contenedor migrate si aún no existe ninguna.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Panel (Vite: llegan al navegador) -------------------------------------------
VITE_API_URL=http://localhost:3000/api
# Cifra la sesión guardada en el navegador. No es un secreto fuerte: el bundle la contiene.
VITE_COOKIE_SECRET=replace-with-a-long-random-value

# --- Portal (Astro: llega al navegador) ------------------------------------------
# En Docker, el render del servidor del portal usa INTERNAL_API_URL (red interna).
INTERNAL_API_URL=
PUBLIC_API_URL=http://localhost:3000/api
